# Copie este arquivo para .env e preencha suas chaves localmente.
# NUNCA envie o arquivo .env para o GitHub.

GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.6-flash
PORT=3000

# Jarvis Agent local (PC)
AGENT_PORT=8787
# Use uma chave aleatória forte com pelo menos 24 caracteres.
JARVIS_AGENT_SECRET=troque_por_um_segredo_forte_e_unico

# Apenas no ambiente hospedado (Vercel): URL HTTPS pública do tunnel que aponta para o Agent.
# Exemplo: https://jarvis-agent.seudominio.com
JARVIS_AGENT_URL=
